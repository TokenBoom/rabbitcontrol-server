# PostgreSQL (required)
POSTGRES_USER=rabbitcontrol
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=rabbitcontrol
DATABASE_URL=postgres://rabbitcontrol:change-me-strong-password@postgres:5432/rabbitcontrol

# Optional Redis ephemeral store (leave empty to use in-memory DashMap)
REDIS_URL=

# Server bind addresses and backlog
RC_HTTP_ADDR=0.0.0.0:21118
RC_SIGNAL_ADDR=0.0.0.0:21116
RC_RELAY_ADDR=0.0.0.0:21117
RC_LISTEN_BACKLOG=4096

# Public endpoint & TLS SANs advertised to clients
RC_PUBLIC_HOST=127.0.0.1
RC_TLS_SAN=
RC_PLAIN_HTTP=false

# Admin web static bundle & auth options
RC_WEB_DIR=/app/web
RC_INIT_ADMIN_EMAIL=admin@rabbitcontrol.local
RC_ADMIN_TOKEN=
RC_CORS_ORIGIN=

# Logging (RUST_LOG takes precedence; RC_LOG is accepted as fallback)
RUST_LOG=info,rc_server=info,tower_http=info
RC_LOG=
